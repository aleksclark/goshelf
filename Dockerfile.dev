# syntax=docker/dockerfile:1.7
# GoShelf dev image — Air hot-reload, source mounted at runtime.
# Dev-only: Go 1.26 so pinned Air v1.67.4 can install (requires go >= 1.26).
# Production Dockerfile remains golang:1.25-alpine. Do not use this image for production.

ARG GO_VERSION=1.26
# air-verse/air is MIT. Pin >=1.62: older 1.61.x overwrote .air.toml with flag defaults.
ARG AIR_VERSION=v1.67.4
ARG TEMPL_VERSION=v0.3.1020

FROM golang:1.26-bookworm

ARG AIR_VERSION
ARG TEMPL_VERSION
ENV CGO_ENABLED=0 \
    GO111MODULE=on \
    GOPATH=/go \
    PATH=/go/bin:/usr/local/go/bin:$PATH

# curl is used by the compose healthcheck against /healthz.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates curl \
 && rm -rf /var/lib/apt/lists/* \
 && go install github.com/air-verse/air@${AIR_VERSION} \
 && go install github.com/a-h/templ/cmd/templ@${TEMPL_VERSION} \
 && air -v \
 && templ version \
 && mkdir -p /tmp/air /data /src/tmp /audiobooks

WORKDIR /src

# Default command is Air as PID1 so SIGTERM reaches the process directly.
# Compose bind-mounts source over /src; binary/tmp live under named volume at /src/tmp.
CMD ["air", "-c", ".air.toml"]
